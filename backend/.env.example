APP_NAME=Farmer Market Guide API
APP_VERSION=2.1.0
APP_ENV=development
API_V1_PREFIX=/api/v1
APP_HOST=0.0.0.0
APP_PORT=8080

POSTGRES_USER=farma
POSTGRES_PASSWORD=farma
POSTGRES_DB=farma_market

DATABASE_URL=postgresql+asyncpg://farma:farma@postgres:5432/farma_market
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_AUDIENCE=farma-market
JWT_ISSUER=farma-auth

COMMISSION_RATE=0.05
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

API_NINJAS_KEY=
COMMODITIES_API_KEY=
USDINR_FALLBACK=83.0

AUDIT_BACKUP_FILE=./logs/audit_log_backup.jsonl
